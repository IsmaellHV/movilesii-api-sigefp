# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================

# Puerto en el que se ejecutará el servidor
PORT=3000

# Host del servidor (localhost para desarrollo)
HOST=localhost

# Entorno de ejecución (development, production, test)
NODE_ENV=development

# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS MYSQL
# ==========================================

# Host de la base de datos
DB_HOST=localhost

# Puerto de MySQL (por defecto 3306)
DB_PORT=3306

# Nombre de la base de datos
DB_NAME=sigefp

# Usuario de la base de datos
DB_USER=root

# Contraseña de la base de datos
DB_PASSWORD=sigefp

# Configuración del pool de conexiones
DB_CONNECTION_LIMIT=10
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000

# ==========================================
# CONFIGURACIÓN DE JWT (JSON Web Tokens)
# ==========================================

# Clave secreta para firmar los tokens JWT (CAMBIAR EN PRODUCCIÓN)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_jwt_secret_super_seguro_aqui_cambiar_en_produccion

# Clave secreta para refresh tokens (opcional, si no se especifica usa JWT_SECRET)
JWT_REFRESH_SECRET=tu_jwt_refresh_secret_super_seguro_aqui

# Tiempo de expiración del token de acceso (ejemplos: 15m, 1h, 24h, 7d)
JWT_EXPIRES_IN=24h

# Tiempo de expiración del refresh token
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# CONFIGURACIÓN DE SEGURIDAD
# ==========================================

# Número de rounds para bcrypt (entre 10-12 recomendado)
BCRYPT_ROUNDS=12

# Configuración de CORS - Dominios permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000

# ==========================================
# CONFIGURACIÓN DE LOGGING
# ==========================================

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info

# Habilitar logging de consultas SQL (true/false)
DB_LOGGING=false

# ==========================================
# CONFIGURACIÓN DE RATE LIMITING
# ==========================================

# Número máximo de requests por ventana de tiempo
RATE_LIMIT_MAX=100

# Ventana de tiempo en minutos
RATE_LIMIT_WINDOW=15

# ==========================================
# CONFIGURACIÓN DE ARCHIVOS
# ==========================================

# Tamaño máximo de archivos en MB
MAX_FILE_SIZE=10

# Tipos de archivos permitidos (separados por coma)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ==========================================
# CONFIGURACIÓN DE EMAIL (OPCIONAL)
# ==========================================

# Configuración SMTP para envío de emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_password_de_aplicacion

# Email remitente
FROM_EMAIL=noreply@gestionfinanciera.com
FROM_NAME=Gestión Financiera

# ==========================================
# CONFIGURACIÓN DE NOTIFICACIONES (OPCIONAL)
# ==========================================

# Habilitar notificaciones por email
EMAIL_NOTIFICATIONS=false

# Habilitar notificaciones push
PUSH_NOTIFICATIONS=false

# ==========================================
# CONFIGURACIÓN DE BACKUP (OPCIONAL)
# ==========================================

# Directorio para backups
BACKUP_DIR=./backups

# Frecuencia de backup automático (en horas)
BACKUP_FREQUENCY=24

# Número máximo de backups a mantener
MAX_BACKUPS=7

# ==========================================
# CONFIGURACIÓN DE DESARROLLO
# ==========================================

# Habilitar modo debug
DEBUG=true

# Mostrar stack traces completos en errores
SHOW_STACK_TRACE=true

# Habilitar recarga automática en desarrollo
AUTO_RELOAD=true

# ==========================================
# CONFIGURACIÓN DE PRODUCCIÓN
# ==========================================

# URL base de la aplicación en producción
BASE_URL=https://tu-dominio.com

# Habilitar HTTPS
HTTPS_ENABLED=false

# Rutas de certificados SSL (solo si HTTPS_ENABLED=true)
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# ==========================================
# CONFIGURACIÓN DE MONITOREO (OPCIONAL)
# ==========================================

# Habilitar métricas de rendimiento
ENABLE_METRICS=false

# Endpoint para health checks
HEALTH_CHECK_ENDPOINT=/health

# ==========================================
# NOTAS IMPORTANTES
# ==========================================

# 1. NUNCA subir el archivo .env al repositorio
# 2. Cambiar todas las claves secretas en producción
# 3. Usar contraseñas seguras para la base de datos
# 4. Configurar correctamente los CORS_ORIGINS en producción
# 5. Habilitar HTTPS en producción
# 6. Revisar y ajustar los límites de rate limiting según necesidades
# 7. Configurar backups automáticos en producción
# 8. Monitorear logs y métricas en producción